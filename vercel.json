{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "backend/static",
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/api/internal/purge-sms-attempts", "schedule": "0 3 * * *" }
  ]
}
