# Copy to .env and fill in. All vars are read with the WALLET_ prefix.

WALLET_DB_PATH=data/wallet.db
WALLET_SESSION_SECRET=change-me-to-a-long-random-string

# First-run admin account. Required until a User row exists; ignored after.
WALLET_ADMIN_USERNAME=admin
WALLET_ADMIN_PASSWORD=change-me

# Optional: path to a Firebase service-account JSON for push notifications.
# Leave unset to run with push disabled — nothing else depends on it.
WALLET_FIREBASE_SERVICE_ACCOUNT_PATH=

WALLET_STATIC_DIR=static
WALLET_INGEST_ATTEMPT_RETENTION_DAYS=14

# Only needed if the frontend is deployed on a different domain than the
# backend (e.g. frontend on Vercel, backend on Fly.io). Comma-separated
# list of allowed frontend origins. Leave empty for same-origin deployments
# (backend serving the built frontend itself) — this also switches the
# session cookie to SameSite=None; Secure, which only works over HTTPS.
WALLET_CORS_ALLOW_ORIGINS=
